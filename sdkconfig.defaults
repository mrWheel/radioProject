CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/radio_4mb.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
#-- Allows radio_audio's fetch_task to fall back to an unverified TLS
#-- connection when a station's certificate chain terminates at a root CA
#-- that isn't in the bundle (e.g. legacy cross-signed roots some
#-- broadcaster CDNs still serve). Only used after verified attempts fail.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
#-- esp_http_client_get_header() only reads headers WE set on the request;
#-- reading server RESPONSE headers (Location, Content-Type, icy-metaint,
#-- ...) requires esp_http_client_get_response_header(), which needs this
#-- storage enabled. Without it those lookups silently always miss.
#-- Some CDNs (e.g. cdnstream.com, used by KJazz 88.1) send more than 20
#-- response headers (icy-* fields, Set-Cookie, X-DAS-SessionId, P3P, ...),
#-- which silently dropped headers past the 20th ("Response header limit
#-- exceeded"); raised so nothing we might need is lost.
CONFIG_ESP_HTTP_CLIENT_SAVE_RESPONSE_HEADERS=y
CONFIG_ESP_HTTP_CLIENT_MAX_SAVED_RESPONSE_HEADERS=32
CONFIG_ESP_HTTP_CLIENT_MAX_RESPONSE_HEADER_SIZE=256
CONFIG_AUDIO_DECODER_MP3_SUPPORT=y
CONFIG_AUDIO_DECODER_AAC_SUPPORT=y
CONFIG_RADIO_ENCODER_REVERSED=n
CONFIG_RADIO_DEFAULT_VOLUME=40
CONFIG_WIFI_PROV_AP_SSID="Internet-Radio-Setup"
CONFIG_WIFI_PROV_AP_PASSWORD=""
CONFIG_WIFI_PROV_PORTAL_TIMEOUT=0
CONFIG_HTTPD_WS_SUPPORT=y
#-- Shared system-wide with radio_audio's own streaming HTTP socket; the
#-- default of 10 could be exhausted just by one browser's page load (5
#-- concurrent httpd connections) plus the audio stream, starving new
#-- connections (e.g. a 2nd browser stuck on "Loading..").
CONFIG_LWIP_MAX_SOCKETS=16

